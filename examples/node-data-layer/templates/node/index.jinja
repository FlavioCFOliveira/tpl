{%- import "node/_types.jinja" as types -%}
{#-
  One schema becomes one ES module package entry, and this is it: the public
  surface of the package, and the aggregate that wires one repository per table
  onto one connection.

  Rendered once per schema, with the whole database in context and no object
  flag, per FR-RND-006:

      tpl -d <schema> render node/index > src/<schema>/index.js

  It re-exports rather than declares. Everything a caller reaches is defined in
  a module beside this one — the errors and the connection in `core.js`, a row
  and its filter in the table's own module — and `export *` carries both the
  run-time bindings and the `@typedef` types, so a caller writes one import.
  A module whose body declared the errors would put every table module in a
  cycle with it; `node/core.jinja` says why at more length.

  Together with `core.js` this is where provenance is recorded. `now` is
  referenced nowhere in this example, per FR-CTX-030.
-#}
{%- set first = database.tables | first -%}
// Code generated by tpl from the {{ database.name }} schema. DO NOT EDIT.
//
// Server:   MariaDB {{ database.server.version }}, series {{ database.server.series }}, standing {{ database.server.standing }}.
// Schema:   {{ database.name }}, {{ database.charset }} / {{ database.collation }}.
// Tables:   {{ database.tables | length }}.
// Renderer: tpl {{ tpl.version }}.

/**
 * A data layer for the `{{ database.name }}` schema, rendered from the catalogue of the
 * server named above.
 *
 * Every table of the schema contributes three modules: the row and the types
 * that address it, a base class carrying create, read, update, delete and
 * search, and an implementation of that base class over mysql2. Each module's
 * public names are re-exported here, so a caller writes
 * `{{ types.type_name(first.name) }}Mysql2` after one import rather than reaching into a file.
 * {@link Repositories} carries one implementation per table over one
 * connection.
 *
 * ### Types
 *
 * A column becomes a JavaScript type through this example's own mapping macro,
 * which is a template of the example and not a feature of `tpl`: `FR-ENV-009`
 * and `FR-ENV-010` declare that `tpl` ships no such filter, and `BR-ENV-002`
 * says why — a type mapping is an opinion, and it belongs to the project that
 * holds it.
 *
 * A nullable column is not the same JavaScript type as a non-nullable one. The
 * non-nullable form is the value type; the nullable form is `T | null`, which
 * is what mysql2 returns a `NULL` as and what `tsc` makes a caller narrow
 * before reading.
 *
 * ### What this package never does
 *
 * No statement it runs interpolates a value. Identifiers were quoted at render
 * time by the tool, values are placeholders MariaDB binds in a prepared
 * statement, and the one part of a statement a caller chooses — the column an
 * ordering names — resolves through a closed mapping into a quoted identifier.
 * A value that is not one of the table's columns is refused rather than
 * interpolated.
 *
 * Nothing here commits, and nothing here writes to the catalogue.
 *
 * @module
 */

/** @import { Connection } from 'mysql2/promise' */

export * from './core.js';
{% for table in database.tables %}export * from './{{ table.name }}.js';
export * from './{{ table.name }}_repository.js';
export * from './{{ table.name }}_mysql2.js';
{% endfor %}
{% for table in database.tables %}import { {{ types.type_name(table.name) }}Mysql2 } from './{{ table.name }}_mysql2.js';
{% endfor %}
/**
 * One repository per table of the `{{ database.name }}` schema.
 *
 * The repositories share one connection. A mysql2 `Connection` carries one
 * session and serialises the statements sent over it, so a caller wanting
 * concurrency builds one `Repositories` per connection — or passes a
 * `PoolConnection`, which is a `Connection` and is what a pool hands out.
 */
export class Repositories {
  /**
   * Build one repository per table of the `{{ database.name }}` schema over `connection`.
   *
   * @param {Connection} connection a connection addressing `SCHEMA`.
   *   `connect` is the one that carries it.
   */
  constructor(connection) {
{% for table in database.tables %}    /**
     * The data layer of `{{ database.name }}.{{ table.name }}`.
     *
     * @type {{ types.braced(types.type_name(table.name) ~ "Mysql2") }}
     */
    this.{{ types.ident(table.name) }} = new {{ types.type_name(table.name) }}Mysql2(connection);
{% endfor %}  }
}
