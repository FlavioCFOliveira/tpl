{%- import "node/_types.jinja" as types -%}
{#-
  The mysql2 implementation of one table's repository.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render node/mysql2 --table <name> > src/<schema>/<name>_mysql2.js

  Four rules govern every statement below, and all four are the template's
  doing rather than the caller's:

  * every identifier is quoted with the `quote` filter of FR-ENV-008, which
    doubles a backtick inside a name and is correct for MariaDB rather than for
    SQL in general;
  * every value is a placeholder. No value a caller supplies is ever part of a
    statement's text, and the one part of a statement a caller does choose —
    the ordering column — arrives as one of that table's own column values and
    resolves through a closed mapping into an identifier quoted here;
  * every statement is run through `Connection.execute`, which prepares it on
    the server. `Connection.query`, which interpolates the values client-side,
    is used nowhere. It is also why no identifier needs a second escape here
    where the Python example had to double a `%`: MariaDB counts the
    placeholders in a statement it parsed itself;
  * no statement is built with a template literal. A quoted MariaDB identifier
    carries backticks, and a backtick is what opens a template literal, so
    every statement and every fragment below is assembled by concatenation.

  Every JavaScript string literal holding a catalogue name is emitted through
  the `json` filter of FR-ENV-036. A JSON string literal is a JavaScript string
  literal — the escapes JSON defines are a subset of JavaScript's — so a name
  carrying a quote, a backslash or a newline is escaped rather than ending the
  literal early.
-#}
{%- if not table.primary_key -%}
{{- fail("node/mysql2.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so read, update and delete have no key to address a row by.") -}}
{%- endif -%}
{%- set model = types.type_name(table.name) -%}
{%- set module = table.name -%}
{%- set prefix = types.ident(table.name) -%}
{%- set qualified = database.name ~ "." ~ table.name -%}
{%- set relation = types.sql_name(table.name) -%}
{#- The column lists of the five statements. Each is built one name per line
    and then joined, because a trailing separator is what `trim` removes and a
    leading one is not. -#}
{%- set select_list -%}
{%- for col in table.columns %}{{ types.select_expression(col) }}
{% endfor -%}
{%- endset -%}
{%- set select_list = select_list | trim | replace("\n", ", ") -%}
{%- set insert_list -%}
{%- for col in table.columns %}{% if not col.generated and col is not auto_increment %}{{ types.sql_name(col.name) }}
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_list = insert_list | trim | replace("\n", ", ") -%}
{%- if not insert_list -%}
{{- fail("node/mysql2.jinja cannot render " ~ qualified ~ ": every column is either generated or the auto-increment key, so an INSERT would name no column. A table of that shape needs a template with no create.") -}}
{%- endif -%}
{%- set insert_marks -%}
{%- for col in table.columns %}{% if not col.generated and col is not auto_increment %}{{ types.bind(col) }}
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_marks = insert_marks | trim | replace("\n", ", ") -%}
{%- set update_list -%}
{%- for col in table.columns %}{% if not col.generated and col is not primary_key %}{{ types.sql_name(col.name) }} = {{ types.bind(col) }}
{% endif %}{% endfor -%}
{%- endset -%}
{%- set update_list = update_list | trim | replace("\n", ", ") -%}
{%- if not update_list -%}
{{- fail("node/mysql2.jinja cannot render " ~ qualified ~ ": every column is either part of the primary key or generated, so an UPDATE would carry an empty SET clause. A table of that shape needs a template with no update.") -}}
{%- endif -%}
{%- set key_list -%}
{%- for key in table.primary_key.columns %}{{ types.sql_name(key.name) }} = {{ types.bind(column(table.name, key.name)) }}
{% endfor -%}
{%- endset -%}
{%- set key_list = key_list | trim | replace("\n", " AND ") -%}
{%- set auto -%}
{%- for col in table.columns %}{% if col is auto_increment %}<auto>{% endif %}{% endfor -%}
{%- endset -%}
// Code generated by tpl from {{ qualified }}. DO NOT EDIT.

/**
 * The mysql2 implementation of the `{{ qualified }}` data layer.
 *
 * @module
 */

/** @import { Connection, ResultSetHeader, RowDataPacket } from 'mysql2/promise' */
/** @import { BoundValue } from './core.js' */
/** @import { {{ model }}, {{ model }}Filter, {{ model }}Key, {{ model }}Order } from './{{ module }}.js' */

import { NotFound, directionSql, failure } from './core.js';
import { {{ prefix }}ColumnSql } from './{{ module }}.js';
import { {{ model }}Repository } from './{{ module }}_repository.js';

/** The table every statement of this module addresses, as an error names it. */
const TABLE = {{ types.js_string(qualified) }};

{% if "ST_AsWKB" in select_list %}/**
 * Selects every column of the table, in catalogue order.
 *
 * A spatial column is asked for as well-known binary, because the value mysql2
 * decodes from the wire format is a JavaScript object that cannot be bound
 * back. `node/_types.jinja` records the measurement.
 */
{% else %}/** Selects every column of the table, in catalogue order. */
{% endif %}const SELECT = {{ types.js_string("SELECT " ~ select_list ~ " FROM " ~ relation) }};

/** Selects the one row a primary key names. */
const READ = {{ types.js_string("SELECT " ~ select_list ~ " FROM " ~ relation ~ " WHERE " ~ key_list) }};

/**
 * Inserts one row. It names neither a generated column nor an auto-increment
 * key, because the server writes both.
 */
const INSERT = {{ types.js_string("INSERT INTO " ~ relation ~ " (" ~ insert_list ~ ") VALUES (" ~ insert_marks ~ ")") }};

/** Writes every column that is neither generated nor part of the key. */
const UPDATE = {{ types.js_string("UPDATE " ~ relation ~ " SET " ~ update_list ~ " WHERE " ~ key_list) }};

/** Removes the one row a primary key names. */
const DELETE = {{ types.js_string("DELETE FROM " ~ relation ~ " WHERE " ~ key_list) }};

/**
 * Build a row from one result tuple.
 *
 * The positions are the order `SELECT` names the columns in, which is
 * catalogue order. Every statement below is run with `rowsAsArray`, so a
 * result is an array and never an object: a column named `__proto__` or
 * `constructor` would otherwise reach an object literal as a key, and the
 * first of those sets a prototype instead of defining a property.
 *
 * The values are whatever mysql2 decoded, and the types `{{ model }}` declares
 * are this example's record of what that is.
 *
 * @param {RowDataPacket} values
 * @returns {{ types.braced(model) }}
 */
function toRow(values) {
  return {
{% for col in table.columns %}    {{ types.ident(col.name) }}: values[{{ loop.index0 }}],
{% endfor %}  };
}

/**
 * The mysql2 data layer of `{{ qualified }}`.
 *
 * Nothing here commits. mysql2 autocommits until a caller calls
 * `beginTransaction`, so transaction control stays with the caller.
 */
export class {{ model }}Mysql2 extends {{ model }}Repository {
  /** @type {Connection} */
  #connection;

  /**
   * Build the data layer of `{{ qualified }}` over `connection`.
   *
   * The connection must address the schema `SCHEMA` names, because the
   * statements above address the table unqualified. `connect` is the
   * connection that carries it.
   *
   * @param {Connection} connection
   */
  constructor(connection) {
    super();
    this.#connection = connection;
  }

  /**
   * Insert `row`.
   *
{% if "<auto>" in auto %}   * The key is assigned by the server and is written back into `row`.
{% else %}   * The whole key is taken from `row`, which the caller therefore fills.
{% endif %}   *
   * @override
   * @param {{ types.braced(model) }} row
   * @returns {Promise<void>}
   */
  async create(row) {
    /** @type {BoundValue[]} */
    const values = [
{% for col in table.columns %}{% if not col.generated and col is not auto_increment %}      row.{{ types.ident(col.name) }},
{% endif %}{% endfor %}    ];
    try {
      const [result] = await this.#connection.execute(INSERT, values);
{% for col in table.columns %}{% if col is auto_increment %}      const { insertId } = /** @type {ResultSetHeader} */ (result);
{% if types.value_type(col) == "string" %}      // The key is a BIGINT and every row of this package carries one as a
      // `string`, because `connect` sets `bigNumberStrings`. mysql2 reports
      // `insertId` as a `number` whatever the column is, so it is converted
      // here rather than left to widen the row's type.
      row.{{ types.ident(col.name) }} = String(insertId);
{% else %}      row.{{ types.ident(col.name) }} = insertId;
{% endif %}{% endif %}{% endfor %}    } catch (cause) {
      throw failure(TABLE, cause);
    }
  }

  /**
   * Return the row `key` names.
   *
   * @override
   * @param {{ types.braced(model ~ "Key") }} key
   * @returns {{ types.braced("Promise<" ~ model ~ ">") }}
   */
  async read(key) {
    /** @type {BoundValue[]} */
    const values = [
{% for pk in table.primary_key.columns %}{% set keyed = column(table.name, pk.name) %}      key.{{ types.ident(keyed.name) }},
{% endfor %}    ];
    try {
      const [rows] = await this.#connection.execute(
        { sql: READ, rowsAsArray: true },
        values,
      );
      const found = /** @type {RowDataPacket[]} */ (rows);
      if (found.length === 0) {
        throw new NotFound(TABLE);
      }
      return toRow(found[0]);
    } catch (cause) {
      throw failure(TABLE, cause);
    }
  }

  /**
   * Write every writable column of `row` over the row its key names.
   *
   * @override
   * @param {{ types.braced(model) }} row
   * @returns {Promise<number>}
   */
  async update(row) {
    /** @type {BoundValue[]} */
    const values = [
{% for col in table.columns %}{% if not col.generated and col is not primary_key %}      row.{{ types.ident(col.name) }},
{% endif %}{% endfor %}{% for pk in table.primary_key.columns %}{% set keyed = column(table.name, pk.name) %}      row.{{ types.ident(keyed.name) }},
{% endfor %}    ];
    try {
      const [result] = await this.#connection.execute(UPDATE, values);
      return /** @type {ResultSetHeader} */ (result).affectedRows;
    } catch (cause) {
      throw failure(TABLE, cause);
    }
  }

  /**
   * Remove the row `key` names.
   *
   * @override
   * @param {{ types.braced(model ~ "Key") }} key
   * @returns {Promise<number>}
   */
  async delete(key) {
    /** @type {BoundValue[]} */
    const values = [
{% for pk in table.primary_key.columns %}{% set keyed = column(table.name, pk.name) %}      key.{{ types.ident(keyed.name) }},
{% endfor %}    ];
    try {
      const [result] = await this.#connection.execute(DELETE, values);
      return /** @type {ResultSetHeader} */ (result).affectedRows;
    } catch (cause) {
      throw failure(TABLE, cause);
    }
  }

  /**
   * Return every row matching `criteria`, ordered by the terms of `order`.
   *
   * @override
   * @param {{ types.braced(model ~ "Filter") }} criteria
   * @param {{ types.braced("readonly " ~ model ~ "Order[]") }} [order]
   * @param {number | null} [limit]
   * @param {number | null} [offset]
   * @returns {{ types.braced("Promise<" ~ model ~ "[]>") }}
   */
  async search(criteria, order = [], limit = null, offset = null) {
    /** @type {string[]} */
    const conditions = [];
    /** @type {BoundValue[]} */
    const values = [];

{% for col in table.columns %}    if (criteria.{{ types.ident(col.name) }} !== undefined) {
      conditions.push({{ types.js_string(types.sql_name(col.name) ~ " = " ~ types.bind(col)) }});
      values.push(criteria.{{ types.ident(col.name) }});
    }
{% if col is numeric or col is temporal %}    if (criteria.{{ types.ident(col.name) }}From !== undefined) {
      conditions.push({{ types.js_string(types.sql_name(col.name) ~ " >= ?") }});
      values.push(criteria.{{ types.ident(col.name) }}From);
    }
    if (criteria.{{ types.ident(col.name) }}To !== undefined) {
      conditions.push({{ types.js_string(types.sql_name(col.name) ~ " <= ?") }});
      values.push(criteria.{{ types.ident(col.name) }}To);
    }
{% endif %}{% if col is textual %}    if (criteria.{{ types.ident(col.name) }}Like !== undefined) {
      conditions.push({{ types.js_string(types.sql_name(col.name) ~ " LIKE ?") }});
      values.push(criteria.{{ types.ident(col.name) }}Like);
    }
{% endif %}{% if col is nullable %}    if (criteria.{{ types.ident(col.name) }}IsNull !== undefined) {
      conditions.push(
        criteria.{{ types.ident(col.name) }}IsNull
          ? {{ types.js_string(types.sql_name(col.name) ~ " IS NULL") }}
          : {{ types.js_string(types.sql_name(col.name) ~ " IS NOT NULL") }},
      );
    }
{% endif %}{% endfor %}
    let sql = SELECT;
    if (conditions.length > 0) {
      sql += ' WHERE ' + conditions.join(' AND ');
    }
    if (order.length > 0) {
      sql +=
        ' ORDER BY ' +
        order
          .map(
            (term) =>
              {{ prefix }}ColumnSql(term.column) +
              ' ' +
              directionSql(term.direction ?? 'asc'),
          )
          .join(', ');
    }
    if (limit !== null) {
      sql += ' LIMIT ?';
      values.push(limit);
      if (offset !== null) {
        sql += ' OFFSET ?';
        values.push(offset);
      }
    }

    try {
      const [rows] = await this.#connection.execute(
        { sql, rowsAsArray: true },
        values,
      );
      return /** @type {RowDataPacket[]} */ (rows).map(toRow);
    } catch (cause) {
      throw failure(TABLE, cause);
    }
  }
}
