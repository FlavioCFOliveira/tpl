{%- import "node/_types.jinja" as types -%}
{#-
  One table becomes one module: the row, its primary key, the closed set of
  columns an ordering may name, and the filter a search takes.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render node/model --table <name> > src/<schema>/<name>.js

  Everything this module declares but the column constants is a **type** and
  nothing else: a `@typedef` has no run-time shape, so a row is a plain object
  and a caller may build one with a literal. That is the JavaScript answer to
  what the Go example got from a struct and the Python example from a
  dataclass, and it is why this module is small where theirs are not.

  The file carries no timestamp. `now` is the single documented source of
  non-reproducibility, per FR-CTX-030, and a generated file that carries one
  produces a diff on every run for a reason that is not a change. Provenance
  worth recording — the server, its series, its standing and the version of
  `tpl` — is rendered once per schema by `node/core.jinja` and
  `node/index.jinja`.

  Free catalogue text below reaches the file as a `//` line comment and never
  as part of a `/** … */` block. A line comment cannot be closed by its own
  content, and a newline in it produces another line comment, per FR-ENV-038;
  the same text inside a JSDoc block could carry a `*/` and end it, or begin a
  line with an `@` and be read as a tag.
-#}
{%- if not table.primary_key -%}
{{- fail("node/model.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so read, update and delete have no key to address a row by. Give the table a primary key, or render it with a template that generates a read-only data layer.") -}}
{%- endif -%}
{%- set model = types.type_name(table.name) -%}
{%- set prefix = types.ident(table.name) -%}
{%- set qualified = database.name ~ "." ~ table.name -%}
// Code generated by tpl from {{ qualified }}. DO NOT EDIT.

/**
 * The `{{ qualified }}` row, the key that addresses it, the columns an ordering may
 * name, and the filter a search takes.
 *
 * @module
 */

/** @import { Direction } from './core.js' */

import { UnknownColumn } from './core.js';
{% if table.comment %}
// The table's own comment, as the catalogue carries it:
{{ table.comment | comment("//") }}
{% endif %}
/**
 * One row of `{{ qualified }}`.
 *
 * Every property is present on a row. A column that admits `NULL` is typed
 * `T | null`, which is what mysql2 hands back for a `NULL` and what `tsc`
 * makes a caller narrow before reading.
 *
 * @typedef {object} {{ model }}
{% for col in table.columns %} * @property {{ types.braced(types.field_type(col)) }} {{ types.ident(col.name) }} {{ types.declared(col) }}
{% if col is primary_key %} *   It is part of the primary key.
{% elif col is unique %} *   It is part of a unique index.
{% endif %}{% if col.comment %} *   Comment: {{ types.jsdoc_text(col.comment) }}
{% endif %}{% endfor %} */

/**
 * The primary key of `{{ qualified }}`.
 *
 * @typedef {object} {{ model }}Key
{% for key in table.primary_key.columns %}{% set keyed = column(table.name, key.name) %} * @property {{ types.braced(types.field_type(keyed)) }} {{ types.ident(keyed.name) }} {{ types.declared(keyed) }}
{% endfor %} */

/**
 * One column of `{{ qualified }}`.
 *
 * A search accepts an ordering term over these values and over nothing else,
 * so an ordering can carry no SQL of its own. A caller may write the column's
 * catalogue name as a string literal instead: {@link {{ model }}Column} is the union
 * of the values below, so the two are the same value and the same type.
 */
export const {{ model }}Columns = Object.freeze(
  /** @type {const} */ ({
{% for col in table.columns %}    /** {{ types.declared(col) }} */
    {{ types.constant(col.name) }}: {{ types.js_string(col.name) }},
{% endfor %}  }),
);

/**
 * A column of `{{ qualified }}` an ordering may name.
 *
 * @typedef {(typeof {{ model }}Columns)[keyof typeof {{ model }}Columns]} {{ model }}Column
 */

/**
 * The one place a column of `{{ qualified }}` becomes SQL.
 *
 * It is closed over the constants above, and every identifier in it was quoted
 * at render time by `tpl`, so no value a caller supplies can reach a
 * statement's text through an ordering term.
 *
 * @type {Readonly<Record<{{ model }}Column, string>>}
 */
const COLUMN_SQL = Object.freeze({
{% for col in table.columns %}  {{ types.js_string(col.name) }}: {{ types.js_string(types.sql_name(col.name)) }},
{% endfor %}});

/**
 * The column as a statement's text names it: quoted for MariaDB.
 *
 * The lookup is by own property and the refusal is unconditional, so a caller
 * that reached past the type — with an unchecked string, or a value read from
 * a request — is refused here rather than interpolated.
 *
 * @param {{ types.braced(model ~ "Column") }} column
 * @returns {string}
 * @throws {UnknownColumn} for every name the table does not carry.
 */
export function {{ prefix }}ColumnSql(column) {
  if (!Object.hasOwn(COLUMN_SQL, column)) {
    throw new UnknownColumn({{ types.js_string(qualified) }}, String(column));
  }
  return COLUMN_SQL[column];
}

/**
 * One ordering term of a search over `{{ qualified }}`.
 *
 * @typedef {object} {{ model }}Order
 * @property {{ types.braced(model ~ "Column") }} column the column to order by
 * @property {Direction} [direction] the direction to order in. Ascending when absent.
 */

/**
 * What narrows a search over `{{ qualified }}`.
 *
 * Every property is optional: a property left absent adds no condition, and the
 * conditions a search does build are joined with `AND`. The empty object is the
 * filter that matches every row.
 *
 * A property is absent for *no condition* and is never `null` for *is NULL*.
 * That question is asked through the `…IsNull` property a nullable column also
 * gets, so the two meanings never collide, and it is why no filter property
 * admits `null`.
 *
 * @typedef {object} {{ model }}Filter
{% for col in table.columns %} * @property {{ types.braced(types.value_type(col)) }} [{{ types.ident(col.name) }}] where set, requires `{{ col.name }}` to equal it.
{% if col is numeric or col is temporal %} * @property {{ types.braced(types.value_type(col)) }} [{{ types.ident(col.name) }}From] where set, requires `{{ col.name }}` to be at least it.
 * @property {{ types.braced(types.value_type(col)) }} [{{ types.ident(col.name) }}To] where set, requires `{{ col.name }}` to be at most it.
{% endif %}{% if col is textual %} * @property {string} [{{ types.ident(col.name) }}Like] where set, requires `{{ col.name }}` to match it, as LIKE matches.
{% endif %}{% if col is nullable %} * @property {boolean} [{{ types.ident(col.name) }}IsNull] where true, requires `{{ col.name }}` to be NULL; where false, requires it not to be.
{% endif %}{% endfor %} */
