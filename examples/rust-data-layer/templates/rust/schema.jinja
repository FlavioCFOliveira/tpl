#[derive(Debug, Clone)]
pub struct Repositories {
{% for table in database.tables %}    /// The data layer of `{{ database.name }}.{{ table.name }}`.
    pub {{ types.ident(table.name) }}: {{ types.type_name(table.name) }}Sqlx,
{% endfor %}}

impl Repositories {
    /// Builds one repository per table of the `{{ database.name }}` schema over `pool`.
    ///
    /// The repositories share the pool, which is a handle and is safe for
    /// concurrent use.
    #[must_use]
    pub fn new(pool: &sqlx::MySqlPool) -> Self {
        Self {
{% for table in database.tables %}            {{ types.ident(table.name) }}: {{ types.type_name(table.name) }}Sqlx::new(pool.clone()),
{% endfor %}        }
    }
}
