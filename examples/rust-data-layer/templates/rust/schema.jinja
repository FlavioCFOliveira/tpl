{%- import "rust/_types.jinja" as types -%}
{#-
  What one schema's module holds beside its tables: the errors, the ordering
  direction, the two column adapters the type mapping names, the connection,
  and the aggregate that wires one repository per table onto one pool.

  Rendered once per schema, with the whole database in context and no object
  flag, per FR-RND-006:

      tpl -d <schema> render rust/schema > src/<schema>.rs

  This is the one file of the module that carries provenance. A generated file
  that records the instant it was written produces a diff on every run for a
  reason that is not a change, so `now` is referenced nowhere in this example —
  FR-CTX-030 makes it the single documented source of non-reproducibility, and
  everything else here is a function of the catalogue and of the templates.
-#}
{%- set module = types.ident(database.name) -%}
// Code generated by tpl from the {{ database.name }} schema. DO NOT EDIT.
//
// Server:   MariaDB {{ database.server.version }}, series {{ database.server.series }}, standing {{ database.server.standing }}.
// Schema:   {{ database.name }}, {{ database.charset }} / {{ database.collation }}.
// Tables:   {{ database.tables | length }}.
// Renderer: tpl {{ tpl.version }}.

//! A data layer for the `{{ database.name }}` schema, rendered from the catalogue of the
//! server named above.
//!
//! Every table of the schema contributes three modules: the row and the types
//! that address it, a repository trait carrying create, read, update, delete
//! and search, and an implementation of that trait over `sqlx`. Each module's
//! public items are re-exported here, so a caller names a row as
//! `{{ module }}::{{ types.type_name((database.tables | first).name) }}` rather than as
//! `{{ module }}::{{ types.ident((database.tables | first).name) }}::{{ types.type_name((database.tables | first).name) }}`. [`Repositories`] carries one
//! implementation per table over one pool.
//!
//! # Types
//!
//! A column becomes a Rust type through this example's own mapping macro,
//! which is a template of the example and not a feature of `tpl`: `FR-ENV-009`
//! declares that `tpl` ships no `rust_type` filter, and `BR-ENV-002` says
//! why — a type mapping is an opinion, and it belongs to the project that
//! holds it.
//!
//! A nullable column is not the same Rust type as a non-nullable one. The
//! non-nullable form is the value type; the nullable form is `Option<T>` of
//! that same type, which `sqlx` decodes a `NULL` into and which the compiler
//! makes a caller open before it reads the value.
//!
//! Two types of the mapping are declared here rather than taken from a crate,
//! because `sqlx` decodes neither on its own: [`Decimal`], which carries a
//! `DECIMAL` column as the exact decimal text the server sends, and [`Wkb`],
//! which carries a spatial column as the bytes it sends — a four-byte SRID
//! followed by well-known binary.
//!
//! # What this module never does
//!
//! No statement below interpolates a value. Identifiers are quoted at render
//! time by the tool, values are placeholders the driver binds, and the one
//! part of a statement a caller chooses — the column an ordering names — is a
//! variant of that table's own column enumeration, resolved through a closed
//! `match` into a `&'static str`. A caller holding a column name as text
//! reaches the enumeration through `FromStr`, which refuses every name the
//! table does not carry.

{% for table in database.tables %}pub mod {{ types.ident(table.name) }};
pub mod {{ types.ident(table.name) }}_repository;
pub mod {{ types.ident(table.name) }}_sqlx;
{% endfor %}
{% for table in database.tables %}{% set model = types.type_name(table.name) %}pub use self::{{ types.ident(table.name) }}::{ {{- model }}, {{ model }}Column, {{ model }}Filter, {{ model }}Key, {{ model }}Order};
pub use self::{{ types.ident(table.name) }}_repository::{{ model }}Repository;
pub use self::{{ types.ident(table.name) }}_sqlx::{{ model }}Sqlx;
{% endfor %}
use sqlx::TypeInfo as _;

/// The schema every statement of this module addresses.
///
/// The tables are addressed unqualified, so a connection this module is given
/// must have been opened against this schema. [`connect`] is the connection
/// that carries it.
pub const SCHEMA: &str = {{ database.name | json }};

/// What a repository of the `{{ database.name }}` schema reports when it does not succeed.
#[derive(Debug)]
#[non_exhaustive]
pub enum Error {
    /// The table carries no row under the key a read was given.
    NotFound {
        /// The qualified table the read addressed.
        table: &'static str,
    },
    /// An ordering term named a column the table does not carry.
    ///
    /// The name never reaches a statement: it is refused here, which is what
    /// keeps an ordering from carrying SQL of its own.
    UnknownColumn {
        /// The qualified table the ordering addressed.
        table: &'static str,
        /// The name that was offered.
        name: String,
    },
    /// An ordering term named a direction that is neither `ASC` nor `DESC`.
    UnknownDirection {
        /// The name that was offered.
        name: String,
    },
    /// The key the server assigned to an inserted row does not fit the Rust
    /// type the column is mapped to.
    AssignedKey {
        /// The qualified table the insert addressed.
        table: &'static str,
        /// The auto-increment column the key was assigned to.
        column: &'static str,
        /// The conversion that refused it.
        source: std::num::TryFromIntError,
    },
    /// The server, the driver or the connection refused the statement.
    Database(Box<sqlx::Error>),
}

impl std::fmt::Display for Error {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::NotFound { table } => write!(formatter, "{table}: no row carries that key"),
            Self::UnknownColumn { table, name } => {
                write!(formatter, "{table}: carries no column named {name:?}")
            }
            Self::UnknownDirection { name } => {
                write!(formatter, "{name:?} is neither an ascending nor a descending direction")
            }
            Self::AssignedKey { table, column, .. } => write!(
                formatter,
                "{table}: the key the server assigned does not fit the Rust type of {column}"
            ),
            Self::Database(source) => write!(formatter, "{SCHEMA}: {source}"),
        }
    }
}

impl std::error::Error for Error {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        match self {
            Self::AssignedKey { source, .. } => Some(source),
            Self::Database(source) => Some(source),
            Self::NotFound { .. } | Self::UnknownColumn { .. } | Self::UnknownDirection { .. } => {
                None
            }
        }
    }
}

impl From<sqlx::Error> for Error {
    fn from(source: sqlx::Error) -> Self {
        Self::Database(Box::new(source))
    }
}

/// The direction of one ordering term.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Hash)]
pub enum Direction {
    /// Orders a column from its smallest value upwards.
    #[default]
    Ascending,
    /// Orders a column from its largest value downwards.
    Descending,
}

impl Direction {
    /// The SQL keyword a search writes into its `ORDER BY` clause.
    #[must_use]
    pub const fn as_sql(self) -> &'static str {
        match self {
            Self::Ascending => "ASC",
            Self::Descending => "DESC",
        }
    }
}

impl std::fmt::Display for Direction {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter.write_str(self.as_sql())
    }
}

impl std::str::FromStr for Direction {
    type Err = Error;

    /// Reads a direction a caller supplied as text, in either case.
    ///
    /// # Errors
    ///
    /// Returns [`Error::UnknownDirection`] for every name but the four below,
    /// so that no text a caller supplies reaches a statement.
    fn from_str(name: &str) -> Result<Self, Self::Err> {
        match name {
            "ASC" | "asc" => Ok(Self::Ascending),
            "DESC" | "desc" => Ok(Self::Descending),
            _ => Err(Error::UnknownDirection { name: name.to_owned() }),
        }
    }
}

/// A `DECIMAL` column, carried as the exact decimal text the server sends.
///
/// `sqlx` decodes a `DECIMAL` into `rust_decimal::Decimal` or
/// `bigdecimal::BigDecimal` and into nothing else — not into `String`, whose
/// compatibility list the type is absent from. This adapter is the mapping
/// that costs no dependency and loses nothing: the server sends the value as
/// text in both protocols, and `f64` could not hold `decimal(38,10)` if it
/// did not.
///
/// A project that wants arithmetic replaces one branch of
/// `templates/rust/_types.jinja` with a decimal crate's type and turns on the
/// matching `sqlx` feature. That is the whole reason the mapping is a template
/// of this example and not a filter of `tpl`, per `BR-ENV-002`.
#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
pub struct Decimal(pub String);

impl Decimal {
    /// The decimal as the server wrote it.
    #[must_use]
    pub fn as_str(&self) -> &str {
        &self.0
    }
}

impl std::fmt::Display for Decimal {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter.write_str(&self.0)
    }
}

impl From<String> for Decimal {
    fn from(text: String) -> Self {
        Self(text)
    }
}

impl AsRef<str> for Decimal {
    fn as_ref(&self) -> &str {
        &self.0
    }
}

impl sqlx::Type<sqlx::MySql> for Decimal {
    fn type_info() -> sqlx::mysql::MySqlTypeInfo {
        <String as sqlx::Type<sqlx::MySql>>::type_info()
    }

    fn compatible(ty: &sqlx::mysql::MySqlTypeInfo) -> bool {
        ty.name() == "DECIMAL" || <String as sqlx::Type<sqlx::MySql>>::compatible(ty)
    }
}

impl<'r> sqlx::Decode<'r, sqlx::MySql> for Decimal {
    fn decode(
        value: sqlx::mysql::MySqlValueRef<'r>,
    ) -> Result<Self, sqlx::error::BoxDynError> {
        <&str as sqlx::Decode<'r, sqlx::MySql>>::decode(value).map(|text| Self(text.to_owned()))
    }
}

impl<'q> sqlx::Encode<'q, sqlx::MySql> for Decimal {
    fn encode_by_ref(
        &self,
        buf: &mut Vec<u8>,
    ) -> Result<sqlx::encode::IsNull, sqlx::error::BoxDynError> {
        <&str as sqlx::Encode<'q, sqlx::MySql>>::encode(self.0.as_str(), buf)
    }
}

/// A spatial column, carried as the bytes the server sends.
///
/// The value is a four-byte SRID in little-endian order followed by the
/// geometry's well-known binary, which is what MariaDB writes on the wire and
/// what `ST_GeomFromWKB` reads back. `sqlx` decodes a `GEOMETRY` column into
/// nothing at all — `Vec<u8>` does not accept the type — so this adapter is
/// what makes the eight spatial types of `freight` reachable.
///
/// It parses nothing. A project that wants geometry replaces one branch of
/// `templates/rust/_types.jinja` with a `geo` type and decodes the bytes into
/// it.
#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
pub struct Wkb(pub Vec<u8>);

impl Wkb {
    /// The bytes as the server wrote them, SRID prefix included.
    #[must_use]
    pub fn as_slice(&self) -> &[u8] {
        &self.0
    }
}

impl From<Vec<u8>> for Wkb {
    fn from(bytes: Vec<u8>) -> Self {
        Self(bytes)
    }
}

impl AsRef<[u8]> for Wkb {
    fn as_ref(&self) -> &[u8] {
        &self.0
    }
}

impl sqlx::Type<sqlx::MySql> for Wkb {
    fn type_info() -> sqlx::mysql::MySqlTypeInfo {
        <Vec<u8> as sqlx::Type<sqlx::MySql>>::type_info()
    }

    fn compatible(ty: &sqlx::mysql::MySqlTypeInfo) -> bool {
        ty.name() == "GEOMETRY" || <Vec<u8> as sqlx::Type<sqlx::MySql>>::compatible(ty)
    }
}

impl<'r> sqlx::Decode<'r, sqlx::MySql> for Wkb {
    fn decode(
        value: sqlx::mysql::MySqlValueRef<'r>,
    ) -> Result<Self, sqlx::error::BoxDynError> {
        <&[u8] as sqlx::Decode<'r, sqlx::MySql>>::decode(value).map(|bytes| Self(bytes.to_owned()))
    }
}

impl<'q> sqlx::Encode<'q, sqlx::MySql> for Wkb {
    fn encode_by_ref(
        &self,
        buf: &mut Vec<u8>,
    ) -> Result<sqlx::encode::IsNull, sqlx::error::BoxDynError> {
        <&[u8] as sqlx::Encode<'q, sqlx::MySql>>::encode(self.0.as_slice(), buf)
    }
}

/// Opens a connection pool onto the `{{ database.name }}` schema.
///
/// The options are the caller's — host, credentials, TLS, timeouts — with the
/// one setting this module cannot work without applied over them: the schema,
/// because the module was rendered from one schema and addresses its tables
/// unqualified.
///
/// # Errors
///
/// Returns [`Error::Database`] where the pool could not be opened.
pub async fn connect(
    options: sqlx::mysql::MySqlConnectOptions,
) -> Result<sqlx::MySqlPool, Error> {
    sqlx::MySqlPool::connect_with(options.database(SCHEMA))
        .await
        .map_err(Error::from)
}

