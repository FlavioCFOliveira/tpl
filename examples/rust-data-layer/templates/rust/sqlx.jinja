{%- import "rust/_types.jinja" as types -%}
{#-
  The `sqlx` implementation of one table's repository.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render rust/sqlx --table <name> > src/<schema>/<name>_sqlx.rs

  Two rules govern every statement below, and both are the template's doing
  rather than the caller's:

  * every identifier is quoted with the `quote` filter of FR-ENV-008, which
    doubles a backtick inside a name and is correct for MariaDB rather than for
    SQL in general;
  * every value is a placeholder. No value a caller supplies is ever part of a
    statement's text, and the one part of a statement a caller does choose —
    the ordering column — arrives as a variant of that table's own enumeration
    and resolves through a closed `match` into an identifier quoted here.

  The five fixed statements are `&'static str` constants, which is also what
  `sqlx` 0.9 requires of them: `sqlx::query` accepts `impl SqlSafeStr`, and
  that trait is implemented for `&'static str` and not for a `String` built at
  run time. The search, whose shape depends on the filter, is therefore built
  with `QueryBuilder` rather than by formatting a string — the interface the
  same rule points a caller at.

  Every Rust string literal holding a catalogue name is emitted through the
  `json` filter of FR-ENV-036, so a name carrying a quote or a backslash is
  escaped rather than ending the literal early.
-#}
{%- if not table.primary_key -%}
{{- fail("rust/sqlx.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so read, update and delete have no key to address a row by.") -}}
{%- endif -%}
{%- set model = types.type_name(table.name) -%}
{%- set module = types.ident(table.name) -%}
{%- set relation = table.name | quote -%}
{#- The column lists of the five statements. Each is built one name per line
    and then joined, because a trailing separator is what `trim` removes and a
    leading one is not. -#}
{%- set select_list -%}
{%- for column in table.columns %}{{ column.name | quote }}
{% endfor -%}
{%- endset -%}
{%- set select_list = select_list | trim | replace("\n", ", ") -%}
{%- set insert_list -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}{{ column.name | quote }}
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_list = insert_list | trim | replace("\n", ", ") -%}
{%- if not insert_list -%}
{{- fail("rust/sqlx.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": every column is either generated or the auto-increment key, so an INSERT would name no column. A table of that shape needs a template with no create.") -}}
{%- endif -%}
{%- set insert_marks -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}?
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_marks = insert_marks | trim | replace("\n", ", ") -%}
{%- set update_list -%}
{%- for column in table.columns %}{% if not column.generated and column is not primary_key %}{{ column.name | quote }} = ?
{% endif %}{% endfor -%}
{%- endset -%}
{%- set update_list = update_list | trim | replace("\n", ", ") -%}
{%- if not update_list -%}
{{- fail("rust/sqlx.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": every column is either part of the primary key or generated, so an UPDATE would carry an empty SET clause. A table of that shape needs a template with no update.") -}}
{%- endif -%}
{%- set key_list -%}
{%- for key in table.primary_key.columns %}{{ key.name | quote }} = ?
{% endfor -%}
{%- endset -%}
{%- set key_list = key_list | trim | replace("\n", " AND ") -%}
{%- set auto -%}
{%- for column in table.columns %}{% if column is auto_increment %}<auto>{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_binds -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}            .bind({{ types.bind("row." ~ types.ident(column.name), column) }})
{% endif %}{% endfor -%}
{%- endset -%}
// Code generated by tpl from {{ database.name }}.{{ table.name }}. DO NOT EDIT.

//! The `sqlx` implementation of the `{{ database.name }}.{{ table.name }}` data layer.

use sqlx::{MySql, QueryBuilder};

use super::Error;
use super::{{ module }}::{ {{- model }}, {{ model }}Filter, {{ model }}Key, {{ model }}Order};
use super::{{ module }}_repository::{{ model }}Repository;

/// The table every statement of this module addresses, as an error names it.
const TABLE: &str = {{ (database.name ~ "." ~ table.name) | json }};

/// Selects every column of the table, in catalogue order.
const SELECT: &str = {{ ("SELECT " ~ select_list ~ " FROM " ~ relation) | json }};

/// Selects the one row a primary key names.
const READ: &str = {{ ("SELECT " ~ select_list ~ " FROM " ~ relation ~ " WHERE " ~ key_list) | json }};

/// Inserts one row.
///
/// It names neither a generated column nor an auto-increment key, because the
/// server writes both.
const INSERT: &str = {{ ("INSERT INTO " ~ relation ~ " (" ~ insert_list ~ ") VALUES (" ~ insert_marks ~ ")") | json }};

/// Writes every column that is neither generated nor part of the key.
const UPDATE: &str = {{ ("UPDATE " ~ relation ~ " SET " ~ update_list ~ " WHERE " ~ key_list) | json }};

/// Removes the one row a primary key names.
const DELETE: &str = {{ ("DELETE FROM " ~ relation ~ " WHERE " ~ key_list) | json }};

/// The `sqlx` data layer of `{{ database.name }}.{{ table.name }}`.
#[derive(Debug, Clone)]
pub struct {{ model }}Sqlx {
    pool: sqlx::MySqlPool,
}

impl {{ model }}Sqlx {
    /// Builds the data layer of `{{ database.name }}.{{ table.name }}` over `pool`.
    ///
    /// The pool must address the schema [`SCHEMA`] names, because the
    /// statements above address the table unqualified. [`connect`] is the pool
    /// that carries it.
    ///
    /// [`SCHEMA`]: super::SCHEMA
    /// [`connect`]: super::connect
    #[must_use]
    pub fn new(pool: sqlx::MySqlPool) -> Self {
        Self { pool }
    }
}

impl {{ model }}Repository for {{ model }}Sqlx {
    async fn create(&self, row: &mut {{ model }}) -> Result<(), Error> {
{% if "<auto>" in auto %}        let assigned = sqlx::query(INSERT)
{{ insert_binds }}            .execute(&self.pool)
            .await?
            .last_insert_id();
{% for column in table.columns %}{% if column is auto_increment %}{% if types.value_type(column) == "u64" %}        row.{{ types.ident(column.name) }} = assigned;
{% else %}        row.{{ types.ident(column.name) }} =
            {{ types.value_type(column) }}::try_from(assigned).map_err(|source| Error::AssignedKey {
                table: TABLE,
                column: {{ column.name | json }},
                source,
            })?;
{% endif %}{% endif %}{% endfor %}{% else %}        sqlx::query(INSERT)
{{ insert_binds }}            .execute(&self.pool)
            .await?;
{% endif %}        Ok(())
    }

    async fn read(&self, key: &{{ model }}Key) -> Result<{{ model }}, Error> {
        sqlx::query_as::<_, {{ model }}>(READ)
{% for pk in table.primary_key.columns %}{% set keyed = column(table.name, pk.name) %}            .bind({{ types.bind("key." ~ types.ident(pk.name), keyed) }})
{% endfor %}            .fetch_optional(&self.pool)
            .await?
            .ok_or(Error::NotFound { table: TABLE })
    }

    async fn update(&self, row: &{{ model }}) -> Result<u64, Error> {
        let outcome = sqlx::query(UPDATE)
{% for column in table.columns %}{% if not column.generated and column is not primary_key %}            .bind({{ types.bind("row." ~ types.ident(column.name), column) }})
{% endif %}{% endfor %}{% for pk in table.primary_key.columns %}{% set keyed = column(table.name, pk.name) %}            .bind({{ types.bind("row." ~ types.ident(pk.name), keyed) }})
{% endfor %}            .execute(&self.pool)
            .await?;

        Ok(outcome.rows_affected())
    }

    async fn delete(&self, key: &{{ model }}Key) -> Result<u64, Error> {
        let outcome = sqlx::query(DELETE)
{% for pk in table.primary_key.columns %}{% set keyed = column(table.name, pk.name) %}            .bind({{ types.bind("key." ~ types.ident(pk.name), keyed) }})
{% endfor %}            .execute(&self.pool)
            .await?;

        Ok(outcome.rows_affected())
    }

    async fn search(
        &self,
        filter: {{ model }}Filter,
        order: &[{{ model }}Order],
        limit: Option<u64>,
        offset: Option<u64>,
    ) -> Result<Vec<{{ model }}>, Error> {
        let mut builder: QueryBuilder<MySql> = QueryBuilder::new(SELECT);

        if !filter.is_empty() {
            builder.push(" WHERE ");
            let mut conditions = builder.separated(" AND ");

{% for column in table.columns %}            if let Some(value) = filter.{{ types.ident(column.name) }} {
                conditions
                    .push({{ ((column.name | quote) ~ " = ") | json }})
                    .push_bind_unseparated(value);
            }
{% if column is numeric or column is temporal %}            if let Some(value) = filter.{{ types.ident(column.name) }}_from {
                conditions
                    .push({{ ((column.name | quote) ~ " >= ") | json }})
                    .push_bind_unseparated(value);
            }
            if let Some(value) = filter.{{ types.ident(column.name) }}_to {
                conditions
                    .push({{ ((column.name | quote) ~ " <= ") | json }})
                    .push_bind_unseparated(value);
            }
{% endif %}{% if column is textual %}            if let Some(value) = filter.{{ types.ident(column.name) }}_like {
                conditions
                    .push({{ ((column.name | quote) ~ " LIKE ") | json }})
                    .push_bind_unseparated(value);
            }
{% endif %}{% if column is nullable %}            if let Some(is_null) = filter.{{ types.ident(column.name) }}_is_null {
                conditions.push(if is_null {
                    {{ ((column.name | quote) ~ " IS NULL") | json }}
                } else {
                    {{ ((column.name | quote) ~ " IS NOT NULL") | json }}
                });
            }
{% endif %}{% endfor %}        }

        if !order.is_empty() {
            builder.push(" ORDER BY ");
            for (position, term) in order.iter().enumerate() {
                if position > 0 {
                    builder.push(", ");
                }
                builder.push(term.column.as_sql());
                builder.push(" ");
                builder.push(term.direction.as_sql());
            }
        }

        if let Some(limit) = limit {
            builder.push(" LIMIT ").push_bind(limit);

            if let Some(offset) = offset {
                builder.push(" OFFSET ").push_bind(offset);
            }
        }

        builder
            .build_query_as::<{{ model }}>()
            .fetch_all(&self.pool)
            .await
            .map_err(Error::from)
    }
}
