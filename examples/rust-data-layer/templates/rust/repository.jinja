/// The data layer of `{{ database.name }}.{{ table.name }}`.
///
/// [`{{ model }}Sqlx`] is the implementation this crate ships, which is over
/// `sqlx`. Every method takes a [`Result`] whose error is [`Error`], and every
/// returned future is `Send`.
///
/// [`{{ model }}Sqlx`]: super::{{ module }}_sqlx::{{ model }}Sqlx
pub trait {{ model }}Repository {
    /// Inserts `row`.
{% if "<auto>" in generated %}    ///
    /// The key is assigned by the server and is written back into `row`.
{% else %}    ///
    /// The whole key is taken from `row`, which the caller therefore fills.
{% endif %}    ///
    /// Neither a generated column nor an auto-increment key is written: the
    /// server writes both.
    ///
    /// # Errors
    ///
    /// Returns [`Error::Database`] where the server refused the insert, and
    /// [`Error::AssignedKey`] where the key it assigned does not fit the Rust
    /// type the column is mapped to.
    fn create(&self, row: &mut {{ model }}) -> impl std::future::Future<Output = Result<(), Error>> + Send;

    /// Returns the row `key` names.
    ///
    /// # Errors
    ///
    /// Returns [`Error::NotFound`] where the table carries no such row, and
    /// [`Error::Database`] where the server refused the query.
    fn read(&self, key: &{{ model }}Key) -> impl std::future::Future<Output = Result<{{ model }}, Error>> + Send;

    /// Writes every writable column of `row` over the row its key names, and
    /// reports how many rows the server changed.
    ///
    /// A key that names nothing is not an error: it changes nothing, and the
    /// count says so. The count is the number of rows whose values actually
    /// changed rather than the number the key matched.
    ///
    /// # Errors
    ///
    /// Returns [`Error::Database`] where the server refused the update.
    fn update(&self, row: &{{ model }}) -> impl std::future::Future<Output = Result<u64, Error>> + Send;

    /// Removes the row `key` names, and reports how many rows the server
    /// removed.
    ///
    /// # Errors
    ///
    /// Returns [`Error::Database`] where the server refused the delete.
    fn delete(&self, key: &{{ model }}Key) -> impl std::future::Future<Output = Result<u64, Error>> + Send;

    /// Returns every row matching `filter`, ordered by the terms of `order`
    /// and in the order they are given.
    ///
    /// `filter` is taken by value because its fields are bound into the
    /// statement. `limit` of `None` returns every matching row, and `offset`
    /// is applied only beside a `limit`.
    ///
    /// An ordering term carries a [`{{ model }}Column`], so no name a caller
    /// supplies reaches the statement's text: the variant resolves through a
    /// closed `match` into an identifier this template quoted.
    ///
    /// # Errors
    ///
    /// Returns [`Error::Database`] where the server refused the query.
    ///
    /// [`{{ model }}Column`]: super::{{ module }}::{{ model }}Column
    fn search(
        &self,
        filter: {{ model }}Filter,
        order: &[{{ model }}Order],
        limit: Option<u64>,
        offset: Option<u64>,
    ) -> impl std::future::Future<Output = Result<Vec<{{ model }}>, Error>> + Send;
}
