{%- import "rust/_types.jinja" as types -%}
{#-
  One table becomes one module: the row, its primary key, the closed set of
  columns an ordering may name, and the filter a search takes.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render rust/struct --table <name> > src/<schema>/<name>.rs

  The file carries no timestamp. `now` is the single documented source of
  non-reproducibility, per FR-CTX-030, and a generated file that carries one
  produces a diff on every run for a reason that is not a change. Provenance
  worth recording — the server, its series, its standing and the version of
  `tpl` — is rendered once per schema by `rust/schema.jinja`.
-#}
{%- if not table.primary_key -%}
{{- fail("rust/struct.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so read, update and delete have no key to address a row by. Give the table a primary key, or render it with a template that generates a read-only data layer.") -}}
{%- endif -%}
{%- set model = types.type_name(table.name) -%}
{#- A floating-point key column would refuse `Eq` and `Hash`, which every other
    mapped key type derives. The marker is how the template asks. -#}
{%- set inexact -%}
{%- for key in table.primary_key.columns %}{% set keyed = column(table.name, key.name) %}{% if types.value_type(keyed) in ["f32", "f64"] %}<inexact>{% endif %}{% endfor -%}
{%- endset -%}
