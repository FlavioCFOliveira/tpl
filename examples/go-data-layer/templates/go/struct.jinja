{%- import "go/_types.jinja" as go -%}
{#-
  One table becomes one Go file: the row struct, its primary key, the closed
  set of column names an ordering may use, and the filter a search takes.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render go/struct --table <name> > <name>.go

  The file carries no timestamp. `now` is the single documented source of
  non-reproducibility, per FR-CTX-030, and a generated file that carries one
  produces a diff on every run for a reason that is not a change. Provenance
  that is worth recording — the server, its series, its standing and the
  version of `tpl` — is rendered once per package by `go/schema.jinja`.
-#}
{%- if not table.primary_key -%}
{{- fail("go/struct.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so Read, Update and Delete have no key to address a row by. Give the table a primary key, or render it with a template that generates a read-only data layer.") -}}
{%- endif -%}
{%- set model = go.go_exported(table.name) -%}
{%- set markers -%}
{%- for column in table.columns -%}
{%- if column is nullable %}<sql>{% endif -%}
{%- if go.go_value_type(column) == "time.Time" %}<time>{% endif -%}
{%- endfor -%}
{%- endset -%}
// Code generated by tpl from {{ database.name }}.{{ table.name }}. DO NOT EDIT.

package {{ database.name | snake }}
{% if "<sql>" in markers or "<time>" in markers %}
import (
{% if "<sql>" in markers %}	"database/sql"
{% endif %}{% if "<time>" in markers %}	"time"
{% endif %})
{% endif %}
// {{ model }} is one row of {{ database.name }}.{{ table.name }}.
{% if table.comment %}//
{{ table.comment | comment("//") }}
{% endif %}type {{ model }} struct {
{% for column in table.columns %}	// {{ go.go_exported(column.name) }} is {{ column.name }}, declared {{ column.column_type }} {{ "NULL" if column is nullable else "NOT NULL" }}{{ " AUTO_INCREMENT" if column is auto_increment }}{{ " INVISIBLE" if column.invisible }}{% if column.generated %} {{ column.generated.storage }} AS ({{ column.generated.expression }}){% endif %}.
{% if column is primary_key %}	// It is part of the primary key.
{% elif column is unique %}	// It is part of a unique index.
{% endif %}{% if column.comment %}	//
{{ column.comment | comment("\t//") }}
{% endif %}	{{ go.go_exported(column.name) }} {{ go.go_type(column) }}
{% endfor %}}

// {{ model }}Key is the primary key of {{ database.name }}.{{ table.name }}.
type {{ model }}Key struct {
{% for key in table.primary_key.columns %}{% set column = column(table.name, key.name) %}	// {{ go.go_exported(column.name) }} is {{ column.name }}.
	{{ go.go_exported(column.name) }} {{ go.go_type(column) }}
{% endfor %}}

// Key returns the primary key of the row.
func (row *{{ model }}) Key() {{ model }}Key {
	var key {{ model }}Key
{% for column in table.primary_key.columns %}	key.{{ go.go_exported(column.name) }} = row.{{ go.go_exported(column.name) }}
{% endfor %}	return key
}

// {{ model }}Column names a column of {{ database.name }}.{{ table.name }}.
//
// A search accepts an ordering term only over the constants below, so an
// ordering can carry no SQL of its own.
type {{ model }}Column string

// The columns of {{ database.name }}.{{ table.name }}, in catalogue order.
const (
{% for column in table.columns %}	// {{ model }}Column{{ go.go_exported(column.name) }} names {{ column.name }}.
	{{ model }}Column{{ go.go_exported(column.name) }} {{ model }}Column = "{{ column.name }}"
{% endfor %})

// {{ model }}Order is one ordering term of a search over {{ database.name }}.{{ table.name }}.
type {{ model }}Order struct {
	// Column is the column to order by.
	Column {{ model }}Column
	// Direction is the direction to order in.
	Direction Direction
}

// {{ model }}Filter narrows a search over {{ database.name }}.{{ table.name }}.
//
// Every field is optional: a field left nil adds no condition, and the
// conditions a search does build are joined with AND.
type {{ model }}Filter struct {
{% for column in table.columns %}	// {{ go.go_exported(column.name) }}, where set, requires {{ column.name }} to equal it.
	{{ go.go_exported(column.name) }} {{ go.go_filter_type(column) }}
{% if (column is numeric or column is temporal) and go.go_value_type(column) != "[]byte" %}	// {{ go.go_exported(column.name) }}From, where set, requires {{ column.name }} to be at least it.
	{{ go.go_exported(column.name) }}From {{ go.go_filter_type(column) }}
	// {{ go.go_exported(column.name) }}To, where set, requires {{ column.name }} to be at most it.
	{{ go.go_exported(column.name) }}To {{ go.go_filter_type(column) }}
{% endif %}{% if column is textual %}	// {{ go.go_exported(column.name) }}Like, where set, requires {{ column.name }} to match it, as LIKE matches.
	{{ go.go_exported(column.name) }}Like *string
{% endif %}{% if column is nullable %}	// {{ go.go_exported(column.name) }}IsNull, where set, requires {{ column.name }} to be NULL when true and not to be NULL when false.
	{{ go.go_exported(column.name) }}IsNull *bool
{% endif %}{% endfor %}}
