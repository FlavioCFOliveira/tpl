{%- import "go/_types.jinja" as go -%}
{#-
  The database/sql implementation of one table's repository.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render go/sql --table <name> > <name>_sql.go

  Two rules govern every statement below, and both are the template's doing
  rather than the caller's:

  * every identifier is quoted with the `quote` filter of FR-ENV-008, which
    doubles a backtick inside a name and is correct for MariaDB rather than for
    SQL in general;
  * every value is a placeholder. No value a caller supplies is ever part of
    the statement text, and the one part of a statement a caller does choose —
    the ordering column — is resolved through a closed switch over the table's
    own columns before it reaches the query.

  Every Go string literal holding a catalogue name is emitted through the
  `json` filter of FR-ENV-036, so a name carrying a quote or a backslash is
  escaped rather than ending the literal early.
-#}
{%- if not table.primary_key -%}
{{- fail("go/sql.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so Read, Update and Delete have no key to address a row by.") -}}
{%- endif -%}
{%- set model = go.go_exported(table.name) -%}
{%- set receiver = go.go_unexported(table.name) -%}
{%- set relation = table.name | quote -%}
{#- The column lists of the five statements. Each is built one name per line and
    then joined, because a trailing separator is what `trim` removes and a
    leading one is not. -#}
{%- set select_list -%}
{%- for column in table.columns %}{{ column.name | quote }}
{% endfor -%}
{%- endset -%}
{%- set select_list = select_list | trim | replace("\n", ", ") -%}
{%- set insert_list -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}{{ column.name | quote }}
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_list = insert_list | trim | replace("\n", ", ") -%}
{%- set insert_marks -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}?
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_marks = insert_marks | trim | replace("\n", ", ") -%}
{%- set update_list -%}
{%- for column in table.columns %}{% if not column.generated and column is not primary_key %}{{ column.name | quote }} = ?
{% endif %}{% endfor -%}
{%- endset -%}
{%- set update_list = update_list | trim | replace("\n", ", ") -%}
{%- if not update_list -%}
{{- fail("go/sql.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": every column is either part of the primary key or generated, so an UPDATE would carry an empty SET clause. A table of that shape needs a template with no Update.") -}}
{%- endif -%}
{%- set key_list -%}
{%- for key in table.primary_key.columns %}{{ key.name | quote }} = ?
{% endfor -%}
{%- endset -%}
{%- set key_list = key_list | trim | replace("\n", " AND ") -%}
{#- The number of conditions a search can build, which is the capacity the two
    slices are given. -#}
{%- set slots -%}
{%- for column in table.columns %}x
{%- if (column is numeric or column is temporal) and go.go_value_type(column) != "[]byte" %}xx{% endif -%}
{%- if column is textual %}x{% endif -%}
{%- if column is nullable %}x{% endif -%}
{%- endfor -%}
{%- endset -%}
{%- set auto -%}
{%- for column in table.columns %}{% if column is auto_increment %}<auto>{% endif %}{% endfor -%}
{%- endset -%}
