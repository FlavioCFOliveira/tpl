{%- import "go/_types.jinja" as go -%}
{#-
  The contract of one table's data layer: create, read, update, delete, and a
  search that filters over several columns and orders by a named column and a
  direction.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render go/repository --table <name> > <name>_repository.go

  The interface is rendered separately from the implementation so that a caller
  can depend on the contract without depending on `database/sql`, and so that
  the difference between the two is visible in the example rather than implied.
-#}
{%- if not table.primary_key -%}
{{- fail("go/repository.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so Read, Update and Delete have no key to address a row by.") -}}
{%- endif -%}
{%- set model = go.go_exported(table.name) -%}
{%- set generated -%}
{%- for column in table.columns %}{% if column is auto_increment %}<auto>{% endif %}{% endfor -%}
{%- endset -%}
// Code generated by tpl from {{ database.name }}.{{ table.name }}. DO NOT EDIT.

package {{ database.name | snake }}

import "context"

// {{ model }}Repository is the data layer of {{ database.name }}.{{ table.name }}.
//
// New{{ model }}Repository builds the implementation this package ships, which
// is over database/sql. Every method takes a context and gives it to the
// server, so a caller cancels a query by cancelling the context it passed.
type {{ model }}Repository interface {
	// Create inserts row.
{% if "<auto>" in generated %}	// The key is assigned by the server and is written back into row.
{% else %}	// The whole key is taken from row, which the caller therefore fills.
{% endif %}	Create(ctx context.Context, row *{{ model }}) error

	// Read returns the row carrying key. It returns an error wrapping
	// ErrNotFound, and no row, when the table carries no such row.
	Read(ctx context.Context, key {{ model }}Key) (*{{ model }}, error)

	// Update writes every writable column of row over the row its key names,
	// and reports how many rows the server changed. A row whose key names
	// nothing is not an error: it changes nothing, and the count says so.
	//
	// Under the driver's default flags the count is the number of rows whose
	// values actually changed, not the number the key matched; setting
	// mysql.Config.ClientFoundRows makes it the number matched.
	Update(ctx context.Context, row *{{ model }}) (int64, error)

	// Delete removes the row carrying key and reports how many rows the server
	// removed.
	Delete(ctx context.Context, key {{ model }}Key) (int64, error)

	// Search returns every row matching filter, ordered by the terms of order
	// and in the order they are given. A limit of zero or less returns every
	// matching row, and an offset is applied only beside a limit. It returns an
	// error wrapping ErrUnknownColumn when an ordering term names a column this
	// table does not carry.
	Search(ctx context.Context, filter {{ model }}Filter, order []{{ model }}Order, limit, offset int) ([]{{ model }}, error)
}
