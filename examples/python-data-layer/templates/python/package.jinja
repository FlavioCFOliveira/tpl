"""A data layer for the `{{ database.name }}` schema, rendered from the catalogue of the
server named above.

Every table of the schema contributes three modules: the row and the types that
address it, a ``Protocol`` carrying create, read, update, delete and search, and
an implementation of that ``Protocol`` over PyMySQL. Each module's public names
are re-exported here, so a caller writes ``{{ package }}.{{ types.type_name(first.name) }}`` rather than
``{{ package }}.{{ types.ident(first.name) }}.{{ types.type_name(first.name) }}``. :class:`Repositories` carries one implementation
per table over one connection.

Types
-----

A column becomes a Python type through this example's own mapping macro, which
is a template of the example and not a feature of ``tpl``: ``FR-ENV-009`` and
``FR-ENV-010`` declare that ``tpl`` ships no such filter, and ``BR-ENV-002``
says why — a type mapping is an opinion, and it belongs to the project that
holds it.

A nullable column is not the same Python type as a non-nullable one. The
non-nullable form is the value type; the nullable form is ``X | None``, which
is what PyMySQL returns a ``NULL`` as and what ``mypy --strict`` makes a caller
narrow before reading.

What this package never does
----------------------------

No statement below interpolates a value. Identifiers were quoted at render time
by the tool, values are placeholders PyMySQL binds, and the one part of a
statement a caller chooses — the column an ordering names — is a member of that
table's own enumeration, resolved through a closed mapping into a quoted
identifier. A caller holding a column name as text reaches the enumeration
through its ``from_name``, which refuses every name the table does not carry.

Nothing here commits, and nothing here writes to the catalogue.
"""

from __future__ import annotations

from pymysql.connections import Connection
from pymysql.cursors import Cursor

from ._core import (
    SCHEMA,
    DatabaseFailure,
    Direction,
    Error,
    NotFound,
    UnknownColumn,
    UnknownDirection,
    connect,
    translating,
)
{% for table in database.tables %}{% set model = types.type_name(table.name) %}from .{{ types.ident(table.name) }} import (
    {{ model }},
    {{ model }}Column,
    {{ model }}Filter,
    {{ model }}Key,
    {{ model }}Order,
)
from .{{ types.ident(table.name) }}_pymysql import {{ model }}PyMySQL
from .{{ types.ident(table.name) }}_repository import {{ model }}Repository
{% endfor %}
__all__ = [
    "SCHEMA",
    "DatabaseFailure",
    "Direction",
    "Error",
    "NotFound",
    "Repositories",
    "UnknownColumn",
    "UnknownDirection",
    "connect",
    "translating",
{% for table in database.tables %}{% set model = types.type_name(table.name) %}    "{{ model }}",
    "{{ model }}Column",
    "{{ model }}Filter",
    "{{ model }}Key",
    "{{ model }}Order",
    "{{ model }}PyMySQL",
    "{{ model }}Repository",
{% endfor %}]


class Repositories:
    """One repository per table of the `{{ database.name }}` schema.

    The repositories share one connection. A PyMySQL connection carries one
    session and is not safe for concurrent use, so a caller that works from
    several threads builds one :class:`Repositories` per connection rather than
    sharing this one — which is the one place this example's aggregate differs
    from a pooled driver's.
    """

    def __init__(self, connection: Connection[Cursor]) -> None:
        """Build one repository per table of the `{{ database.name }}` schema over `connection`.

        Args:
            connection: a connection addressing :data:`SCHEMA`. :func:`connect`
                is the one that carries it.
        """
{% for table in database.tables %}        #: The data layer of `{{ database.name }}.{{ table.name }}`.
        self.{{ types.ident(table.name) }}: {{ types.type_name(table.name) }}PyMySQL = {{ types.type_name(table.name) }}PyMySQL(connection)
{% endfor %}
