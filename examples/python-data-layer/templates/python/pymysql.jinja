{%- import "python/_types.jinja" as types -%}
{#-
  The PyMySQL implementation of one table's repository.

  Rendered once per table, per FR-RND-002 and FR-EX-005:

      tpl -d <schema> render python/pymysql --table <name> > datalayer/<schema>/<name>_pymysql.py

  Three rules govern every statement below, and all three are the template's
  doing rather than the caller's:

  * every identifier is quoted with the `quote` filter of FR-ENV-008, which
    doubles a backtick inside a name and is correct for MariaDB rather than for
    SQL in general;
  * every value is a placeholder. No value a caller supplies is ever part of a
    statement's text, and the one part of a statement a caller does choose —
    the ordering column — arrives as a member of that table's own enumeration
    and resolves through a closed mapping into an identifier quoted here;
  * every `%` that comes from an identifier is **doubled**, and every
    `execute` is passed a tuple rather than `None`. PyMySQL's paramstyle is
    `format`: it builds the final statement as `query % arguments`, so a `%`
    inside a quoted identifier would be read as the start of a conversion. A
    `%` beside an `s` would then silently consume an argument, which is the
    one failure here that would not announce itself. No column of these three
    schemas carries a `%`; the doubling costs one filter and is done anyway.

  Every Python string literal holding a catalogue name is emitted through the
  `json` filter of FR-ENV-036. A JSON string literal is a Python string literal
  — the escapes JSON defines are a subset of Python's — so a name carrying a
  quote or a backslash is escaped rather than ending the literal early.
-#}
{%- if not table.primary_key -%}
{{- fail("python/pymysql.jinja cannot render " ~ database.name ~ "." ~ table.name ~ ": the table declares no primary key, so read, update and delete have no key to address a row by.") -}}
{%- endif -%}
{%- set model = types.type_name(table.name) -%}
{%- set module = types.ident(table.name) -%}
{%- set qualified = database.name ~ "." ~ table.name -%}
{%- set relation = types.sql_name(table.name) -%}
{#- The column lists of the five statements. Each is built one name per line
    and then joined, because a trailing separator is what `trim` removes and a
    leading one is not. -#}
{%- set select_list -%}
{%- for column in table.columns %}{{ types.sql_name(column.name) }}
{% endfor -%}
{%- endset -%}
{%- set select_list = select_list | trim | replace("\n", ", ") -%}
{%- set insert_list -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}{{ types.sql_name(column.name) }}
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_list = insert_list | trim | replace("\n", ", ") -%}
{%- if not insert_list -%}
{{- fail("python/pymysql.jinja cannot render " ~ qualified ~ ": every column is either generated or the auto-increment key, so an INSERT would name no column. A table of that shape needs a template with no create.") -}}
{%- endif -%}
{%- set insert_marks -%}
{%- for column in table.columns %}{% if not column.generated and column is not auto_increment %}%s
{% endif %}{% endfor -%}
{%- endset -%}
{%- set insert_marks = insert_marks | trim | replace("\n", ", ") -%}
{%- set update_list -%}
{%- for column in table.columns %}{% if not column.generated and column is not primary_key %}{{ types.sql_name(column.name) }} = %s
{% endif %}{% endfor -%}
{%- endset -%}
{%- set update_list = update_list | trim | replace("\n", ", ") -%}
{%- if not update_list -%}
{{- fail("python/pymysql.jinja cannot render " ~ qualified ~ ": every column is either part of the primary key or generated, so an UPDATE would carry an empty SET clause. A table of that shape needs a template with no update.") -}}
{%- endif -%}
{%- set key_list -%}
{%- for key in table.primary_key.columns %}{{ types.sql_name(key.name) }} = %s
{% endfor -%}
{%- endset -%}
{%- set key_list = key_list | trim | replace("\n", " AND ") -%}
{%- set auto -%}
{%- for column in table.columns %}{% if column is auto_increment %}<auto>{% endif %}{% endfor -%}
{%- endset -%}
