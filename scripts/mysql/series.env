# The fixture's inventory, in one place.
#
# Sourced by up.sh, down.sh, status.sh, observe.sh and auth-cache.sh. It is
# shell, not a table in prose, because a second copy of five port numbers is a
# second thing that can be wrong: `scripts/mysql/README.md` documents this file
# rather than repeating it.
#
# TPL_MYSQL_IMAGES carries one record per MySQL series the fixture builds:
#
#     <series> <upstream image, pinned by tag and by digest>
#
# The tag names the exact release, and the digest names the exact build of it:
# the official `mysql` tags are rebuilt in place when their base image changes,
# so a tag alone would let two runs of this fixture observe two builds. Each
# digest is the multi-architecture index digest Docker Hub reported for the tag
# on 2026-11-04, and covers `linux/amd64` and `linux/arm64`.
#
# `8.4` and `9.7` are the series of FR-MYSQL-003, each at its latest release on
# that date. `8.0` is not a supported series: it is the server of a series
# outside FR-MYSQL-003 and older than its newest series that FR-MYSQL-044
# requires, for the refusal of FR-MYSQL-009. `8.0.46` is the series' last
# release, and the version FR-MYSQL-009's own example names.

TPL_MYSQL_IMAGES='
8.4  mysql:8.4.13@sha256:a81d043930e51745522bd5c430961cf8286f0a23f0a9a2a6e0108f7ea71b0902
9.7  mysql:9.7.4@sha256:df90258da46f6e7ff8574ff84f17618aba0765cac749928299c69fd4e7cb8ad8
8.0  mysql:8.0.46@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
'

# TPL_MYSQL_SERVERS carries one record per server:
#
#     <name> <series> <image tag> <container> <host port> <tls> <standing>
#
# `name` is how the scripts and the environment refer to a server. `tls` is
# `yes` for a server presenting the fixture certificate and `no` for one started
# with `--tls-version=`, which offers no TLS. `standing` is `supported` for a
# server of a series of FR-MYSQL-003 and `refused` for the one outside it.
#
# The two `tls yes` / `supported` servers are the series of FR-MYSQL-003, one
# each. The two `notls-*` servers are not further series: they are the server
# offering no TLS that FR-MYSQL-044 requires, presented at each supported series
# because FR-MYSQL-021 and FR-MYSQL-045 owe their no-TLS cells an observation on
# every series. The `8.0` server presents the fixture certificate, so that a
# `mysql` entry reaches the version check under the default `tls` mode.
#
# The ports are a contiguous block, 13320 to 13324, clear of 13306 to 13310,
# which the MariaDB fixture of `scripts/mariadb/` publishes.

TPL_MYSQL_SERVERS='
8.4        8.4  tpl-mysql:8.4  tpl-mysql-8.4        13320  yes  supported
9.7        9.7  tpl-mysql:9.7  tpl-mysql-9.7        13321  yes  supported
notls-8.4  8.4  tpl-mysql:8.4  tpl-mysql-notls-8.4  13322  no   supported
notls-9.7  9.7  tpl-mysql:9.7  tpl-mysql-notls-9.7  13323  no   supported
8.0        8.0  tpl-mysql:8.0  tpl-mysql-8.0        13324  yes  refused
'

# Credentials. Not secret, and stated once: README.md's table documents them.
# They are the MariaDB fixture's, so that a test written against one provider
# names the same accounts against the other. TPL_MYSQL_ROOT_USER is the account
# the entrypoint creates from MYSQL_ROOT_PASSWORD; it is stated here so that a
# test names it from this file rather than from a literal of its own.
TPL_MYSQL_ROOT_USER='root'
TPL_MYSQL_ROOT_PASSWORD='tpl-root'
TPL_MYSQL_READER_USER='tpl_reader'
TPL_MYSQL_READER_PASSWORD='tpl-reader-pw'

# The three schemas every server carries, and what a clean start leaves in each.
# up.sh checks every figure rather than trusting `docker ps`.
#
#   freight        the main schema: FR-MYSQL-044's catalogue cases
#   masterdata     the second schema of FR-MYSQL-044 item 8, which declares no
#                  character set and no collation of its own (item 16)
#   freight_empty  a database holding no object, the second side of the
#                  equality FR-MYSQL-042 takes for NFR-PERF-001
TPL_MYSQL_SCHEMA='freight'
TPL_MYSQL_SECOND_SCHEMA='masterdata'
TPL_MYSQL_EMPTY_SCHEMA='freight_empty'

TPL_MYSQL_EXPECTED_TABLES=22
TPL_MYSQL_EXPECTED_VIEWS=5
TPL_MYSQL_EXPECTED_ROUTINES=7
TPL_MYSQL_EXPECTED_TRIGGERS=7
TPL_MYSQL_EXPECTED_EVENTS=1
TPL_MYSQL_EXPECTED_SECOND_TABLES=2
TPL_MYSQL_EXPECTED_EMPTY_OBJECTS=0

# Iterate over the inventory. Usage:
#
#     tpl_mysql_each my_function             # every server
#     tpl_mysql_each my_function tls         # the series of FR-MYSQL-003, one server each
#     tpl_mysql_each my_function notls       # the servers offering no TLS
#     tpl_mysql_each my_function supported   # every server of a series of FR-MYSQL-003
#     tpl_mysql_each my_function refused     # the server outside FR-MYSQL-003
#
# The callback receives: name series image container port tls standing
#
# The callback may read stdin. The inventory is read on file descriptor 9, so a
# callback that runs `docker exec -i` — which reads stdin and drains whatever is
# queued on it — cannot eat the records still to be read; a loop fed from stdin
# would end after the first server, silently and with exit 0. Descriptor 9 and
# not 3: tpl_mysql_handshake below opens the port on 3.
tpl_mysql_each() {
    local callback="$1" filter="${2:-all}"
    local name series image container port tls standing
    while read -r name series image container port tls standing <&9; do
        [ -n "$name" ] || continue
        case "$filter" in
            all)       ;;
            tls)       [ "$tls" = yes ] && [ "$standing" = supported ] || continue ;;
            notls)     [ "$tls" = no ] || continue ;;
            supported) [ "$standing" = supported ] || continue ;;
            refused)   [ "$standing" = refused ] || continue ;;
            *) printf 'tpl_mysql_each: unknown filter: %s\n' "$filter" >&2; return 2 ;;
        esac
        "$callback" "$name" "$series" "$image" "$container" "$port" "$tls" "$standing"
    done 9<<< "$TPL_MYSQL_SERVERS"
}

# The upstream image a series is built from, tag and digest.
tpl_mysql_base_image() {
    printf '%s\n' "$TPL_MYSQL_IMAGES" | awk -v s="$1" '$1 == s { print $2; found = 1 } END { exit !found }'
}

# Every container name the fixture owns, space separated. down.sh removes
# exactly these and nothing else: the host may be running containers that
# belong to other projects.
tpl_mysql_containers() {
    printf '%s\n' "$TPL_MYSQL_SERVERS" | awk 'NF {printf "%s ", $4}'
}

# One record, by name. Prints the whole line; field 2 is the series, 3 the
# image, 4 the container, 5 the host port, 6 whether it offers TLS, 7 its
# standing.
tpl_mysql_record() {
    printf '%s\n' "$TPL_MYSQL_SERVERS" | awk -v n="$1" '$1 == n { print; found = 1 } END { exit !found }'
}

tpl_mysql_field() { tpl_mysql_record "$1" | awk -v f="$2" '{ print $f }'; }

# Run SQL as a named user on a named server, over the container's Unix socket.
# The socket sidesteps every TLS question, which is what an observer wants: it
# is there to watch the connections under test, not to add one of its own to
# the transport matrix. A socket connection is also a secure transport to
# caching_sha2_password, so it never needs the server's RSA public key.
#
# The password travels in MYSQL_PWD, inside the container, rather than on the
# client's command line, where every client of every series prints a warning
# about it on each call.
tpl_mysql_sql_as() {
    local name="$1" user="$2" password="$3"; shift 3
    local container
    container="$(tpl_mysql_field "$name" 4)"
    [ -n "$container" ] || { printf 'unknown server: %s\n' "$name" >&2; return 2; }
    docker exec -i -e "MYSQL_PWD=$password" "$container" mysql -u"$user" "$@"
}

# The same, as root, which is what all but one caller wants.
tpl_mysql_sql() {
    local name="$1"; shift
    tpl_mysql_sql_as "$name" root "$TPL_MYSQL_ROOT_PASSWORD" "$@"
}

# Is a MySQL answering on a host port? Prints the version its handshake
# carries, and fails when nothing answers.
#
# This is the fixture's one readiness test, and it is deliberately made from
# outside every container: during initialisation the official entrypoint runs a
# temporary server with --skip-networking, which answers over the Unix socket
# and is not the server under test. A readiness check made with `docker exec`
# therefore passes in the middle of the init scripts and hands the caller a
# server that is about to restart. The published port is up only when the real
# server is.
#
# It needs no client installed, which matters for the gate: a contributor may
# have none and must still be able to ask whether the fixture is up.
tpl_mysql_handshake() {
    local port="$1" first version
    exec 3<>"/dev/tcp/127.0.0.1/$port" || return 1

    # One byte first, with a timeout. A port that accepts a connection and then
    # says nothing is what a half-started container looks like, and it must not
    # block the gate; a MySQL server answers immediately.
    if ! IFS= read -r -n 1 -t 5 first <&3; then
        exec 3<&- 3>&-
        return 1
    fi

    # The rest of the greeting: a four-byte packet header, the protocol version
    # byte, then the server version as a NUL-terminated string. A MySQL greeting
    # is about 78 bytes, so 39 more never block and the version is inside them;
    # asking for more bytes than the packet holds blocks until the server gives
    # up on the handshake, because the server then waits for the client. Reading
    # to the first NUL instead does not work: the packet header's own length
    # field contains NUL bytes.
    version="$(head -c 39 <&3 | LC_ALL=C tr -c '[:print:]' '\n' \
        | awk '/^[0-9]+\.[0-9]+\.[0-9]+/ { print; exit }')"
    exec 3<&- 3>&-

    [ -n "$version" ] || return 1
    printf '%s\n' "$version"
}
