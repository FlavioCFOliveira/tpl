# The fixture's inventory, in one place.
#
# Sourced by up.sh, down.sh, status.sh and observe.sh. It is shell, not a table
# in prose, because a second copy of four port numbers is a second thing that
# can be wrong: `scripts/mariadb/README.md` documents this file rather than
# repeating it.
#
# TPL_MARIADB_SERVERS carries one record per line:
#
#     <name> <series> <image tag> <container> <host port> <tls>
#
# `name` is how the scripts and the environment refer to a server; `tls` is
# `yes` for a server presenting the fixture certificate and `no` for the one
# started --skip-ssl. The four TLS servers are the series of FR-SRV-015; the
# fifth record is not a fifth series.

TPL_MARIADB_SERVERS='
10.11  10.11  tpl-mariadb:10.11  tpl-mariadb-10.11  13306  yes
11.4   11.4   tpl-mariadb:11.4   tpl-mariadb-11.4   13307  yes
11.8   11.8   tpl-mariadb:11.8   tpl-mariadb-11.8   13308  yes
12.3   12.3   tpl-mariadb:12.3   tpl-mariadb-12.3   13309  yes
notls  10.11  tpl-mariadb:10.11  tpl-mariadb-notls  13310  no
'

# Credentials. Not secret, and stated once: README.md's table documents them.
TPL_MARIADB_ROOT_PASSWORD='tpl-root'
TPL_MARIADB_READER_USER='tpl_reader'
TPL_MARIADB_READER_PASSWORD='tpl-reader-pw'

# The schema every server carries, and the number of catalogue objects a clean
# start leaves in it. up.sh checks the count rather than trusting `docker ps`.
TPL_MARIADB_SCHEMA='freight'
TPL_MARIADB_EXPECTED_TABLES=23

# The two benchmark schemas of NFR-PERF-001, and the counts each realises.
#
# Neither is in the image: `seed-bench.sql` is loaded on demand by
# `seed-bench.sh`, because BR-PERF-002 keeps the benchmark workload out of the
# correctness path. A container that has only been brought up carries `freight`
# and neither of these.
#
# The figures are the ones `specification/performance-requirements.md` states
# for WL-001 and WL-003, restated here in the form the scripts read; the
# counting rule for each is in `seed-bench.sh`, beside the statement that counts
# it, and in README.md.
TPL_MARIADB_BENCH_LARGE_SCHEMA='freight_wl001'
TPL_MARIADB_BENCH_SMALL_SCHEMA='freight_wl003'

TPL_MARIADB_WL001_TABLES=200
TPL_MARIADB_WL001_COLUMNS=2400
TPL_MARIADB_WL001_INDEXES=600
TPL_MARIADB_WL001_FOREIGN_KEYS=180
TPL_MARIADB_WL001_GENERATED=40
TPL_MARIADB_WL001_TRIGGERS=25
TPL_MARIADB_WL001_VIEWS=30
TPL_MARIADB_WL001_ROUTINES=40
TPL_MARIADB_WL001_COMMENTED=120

TPL_MARIADB_WL003_TABLES=1
TPL_MARIADB_WL003_COLUMNS=12
TPL_MARIADB_WL003_INDEXES=3

# The two published datasets of FR-EX-006, and the counts each leaves behind.
#
# Neither is in the image, on the same grounds that keep the benchmark workload
# out of it: only the worked examples need them, and a correctness run must not
# pay for 20 schemas and 113 catalogue objects it never reads. `seed-datasets.sh`
# loads them on demand, into one named server.
#
# The SQL is vendored verbatim under `datasets/`, one directory per dataset,
# each carrying the note that records where it came from and when.
#
# The figures below were measured on 12.3, which is the series FR-EX-006 reads;
# they are counted on the rules `seed-bench.sh` states and README.md documents.
# Three of them are worth knowing before they surprise someone:
#
#   sakila carries 6 triggers, not the 3 its schema file declares: the data file
#   adds customer_create_date, payment_date and rental_date.
#
#   sakila.address carries 8 columns and no `location`. Its GEOMETRY column sits
#   behind a /*!50705 */ executable comment, and MariaDB ignores every such
#   comment whose version lies between 50700 and 99999. Nothing errors; the
#   column is simply never declared, on any series.
#
#   Neither dataset carries a generated column or a table comment, which is part
#   of why FR-EX-006 needs `freight` as its third schema.
TPL_MARIADB_SAKILA_SCHEMA='sakila'
TPL_MARIADB_WORLD_SCHEMA='world'

TPL_MARIADB_SAKILA_TABLES=16
TPL_MARIADB_SAKILA_COLUMNS=89
TPL_MARIADB_SAKILA_INDEXES=41
TPL_MARIADB_SAKILA_FOREIGN_KEYS=22
TPL_MARIADB_SAKILA_GENERATED=0
TPL_MARIADB_SAKILA_TRIGGERS=6
TPL_MARIADB_SAKILA_VIEWS=7
TPL_MARIADB_SAKILA_ROUTINES=6
TPL_MARIADB_SAKILA_COMMENTED=0

TPL_MARIADB_WORLD_TABLES=3
TPL_MARIADB_WORLD_COLUMNS=24
TPL_MARIADB_WORLD_INDEXES=5
TPL_MARIADB_WORLD_FOREIGN_KEYS=2
TPL_MARIADB_WORLD_GENERATED=0
TPL_MARIADB_WORLD_TRIGGERS=0
TPL_MARIADB_WORLD_VIEWS=0
TPL_MARIADB_WORLD_ROUTINES=0
TPL_MARIADB_WORLD_COMMENTED=0

# Iterate over the inventory. Usage:
#
#     tpl_mariadb_each my_function          # every server
#     tpl_mariadb_each my_function tls      # the four of FR-SRV-015 only
#     tpl_mariadb_each my_function notls    # the --skip-ssl server only
#
# The callback receives: name series image container port tls
#
# The callback may read stdin. The inventory is read on file descriptor 9, so a
# callback that runs `docker exec -i` — which reads stdin and drains whatever is
# queued on it — cannot eat the records still to be read. Fed from stdin, as
# this loop was, the callback consumed the other records and the loop ended
# after the first server, silently and with exit 0. up.sh reads the same
# inventory on a descriptor of its own for the same reason. Descriptor 9 and
# not 3: tpl_mariadb_handshake below opens the port on 3.
tpl_mariadb_each() {
    local callback="$1" filter="${2:-all}"
    local name series image container port tls
    while read -r name series image container port tls <&9; do
        [ -n "$name" ] || continue
        case "$filter" in
            tls)   [ "$tls" = yes ] || continue ;;
            notls) [ "$tls" = no ]  || continue ;;
        esac
        "$callback" "$name" "$series" "$image" "$container" "$port" "$tls"
    done 9<<< "$TPL_MARIADB_SERVERS"
}

# Every container name the fixture owns, space separated. down.sh removes
# exactly these and nothing else: the host may be running containers that
# belong to other projects.
tpl_mariadb_containers() {
    printf '%s\n' "$TPL_MARIADB_SERVERS" | awk 'NF {printf "%s ", $4}'
}

# One record, by name. Prints the whole line; field 2 is the series, 3 the
# image, 4 the container, 5 the host port, 6 whether it offers TLS.
tpl_mariadb_record() {
    printf '%s\n' "$TPL_MARIADB_SERVERS" | awk -v n="$1" '$1 == n { print; found = 1 } END { exit !found }'
}

tpl_mariadb_field() { tpl_mariadb_record "$1" | awk -v f="$2" '{ print $f }'; }

# The flags a `docker exec` client needs to reach its own server. Only the
# --skip-ssl server needs one: a client of 11.4 or later refuses a server that
# offers no TLS even over the Unix socket, and answers "SSL is required, but the
# server does not support it".
tpl_mariadb_client_flags() {
    [ "$(tpl_mariadb_field "$1" 6)" = no ] && printf -- '--skip-ssl' || true
}

# Run SQL as a named user on a named server, over the container's Unix socket.
# The socket sidesteps every TLS question, which is what an observer wants: it
# is there to watch the connections under test, not to add one of its own to
# the transport matrix.
tpl_mariadb_sql_as() {
    local name="$1" user="$2" password="$3"; shift 3
    local container flags
    container="$(tpl_mariadb_field "$name" 4)"
    [ -n "$container" ] || { printf 'unknown server: %s\n' "$name" >&2; return 2; }
    flags="$(tpl_mariadb_client_flags "$name")"
    docker exec -i "$container" mariadb $flags -u"$user" -p"$password" "$@"
}

# The same, as root, which is what all but one caller wants. It is the older
# spelling and stays the one to reach for; `tpl_mariadb_sql_as` exists because
# seed-datasets.sh has to ask what the unprivileged reader can see, and a
# question asked as root would answer about root.
tpl_mariadb_sql() {
    local name="$1"; shift
    tpl_mariadb_sql_as "$name" root "$TPL_MARIADB_ROOT_PASSWORD" "$@"
}

# Is a MariaDB answering on a host port? Prints the version its handshake
# carries, and fails when nothing answers.
#
# This is the fixture's one readiness test, and it is deliberately made from
# outside every container: during initialisation the official entrypoint runs a
# temporary server with --skip-networking, which answers over the Unix socket
# and is not the server under test. A readiness check made with `docker exec`
# therefore passes in the middle of the init scripts and hands the caller a
# server that is about to restart. The published port is up only when the real
# server is.
#
# It needs no client installed, which matters for the gate: a contributor may
# have none and must still be able to ask whether the fixture is up.
tpl_mariadb_handshake() {
    local port="$1" first version
    exec 3<>"/dev/tcp/127.0.0.1/$port" || return 1

    # One byte first, with a timeout. A port that accepts a connection and then
    # says nothing is what a half-started container looks like, and it must not
    # block the gate; a MariaDB answers immediately.
    if ! IFS= read -r -n 1 -t 5 first <&3; then
        exec 3<&- 3>&-
        return 1
    fi

    # The rest of the greeting: a four-byte packet header, the protocol version
    # byte, then the server version as a NUL-terminated string. The whole packet
    # is about a hundred bytes on every series, so 79 more never blocks and the
    # version is well inside them. Reading to the first NUL instead does not
    # work: the packet header's own length field contains NUL bytes and the read
    # stops on the second one.
    version="$(head -c 79 <&3 | LC_ALL=C tr -c '[:print:]' '\n' \
        | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    exec 3<&- 3>&-

    [ -n "$version" ] || return 1
    printf '%s\n' "$version"
}
