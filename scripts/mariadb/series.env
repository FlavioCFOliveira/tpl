# The fixture's inventory, in one place.
#
# Sourced by up.sh, down.sh, status.sh and observe.sh. It is shell, not a table
# in prose, because a second copy of four port numbers is a second thing that
# can be wrong: `scripts/mariadb/README.md` documents this file rather than
# repeating it.
#
# TPL_MARIADB_SERVERS carries one record per line:
#
#     <name> <series> <image tag> <container> <host port> <tls>
#
# `name` is how the scripts and the environment refer to a server; `tls` is
# `yes` for a server presenting the fixture certificate and `no` for the one
# started --skip-ssl. The four TLS servers are the series of FR-SRV-015; the
# fifth record is not a fifth series.

TPL_MARIADB_SERVERS='
10.11  10.11  tpl-mariadb:10.11  tpl-mariadb-10.11  13306  yes
11.4   11.4   tpl-mariadb:11.4   tpl-mariadb-11.4   13307  yes
11.8   11.8   tpl-mariadb:11.8   tpl-mariadb-11.8   13308  yes
12.3   12.3   tpl-mariadb:12.3   tpl-mariadb-12.3   13309  yes
notls  10.11  tpl-mariadb:10.11  tpl-mariadb-notls  13310  no
'

# Credentials. Not secret, and stated once: README.md's table documents them.
TPL_MARIADB_ROOT_PASSWORD='tpl-root'
TPL_MARIADB_READER_USER='tpl_reader'
TPL_MARIADB_READER_PASSWORD='tpl-reader-pw'

# The schema every server carries, and the number of catalogue objects a clean
# start leaves in it. up.sh checks the count rather than trusting `docker ps`.
TPL_MARIADB_SCHEMA='freight'
TPL_MARIADB_EXPECTED_TABLES=23

# Iterate over the inventory. Usage:
#
#     tpl_mariadb_each my_function          # every server
#     tpl_mariadb_each my_function tls      # the four of FR-SRV-015 only
#     tpl_mariadb_each my_function notls    # the --skip-ssl server only
#
# The callback receives: name series image container port tls
tpl_mariadb_each() {
    local callback="$1" filter="${2:-all}"
    local name series image container port tls
    printf '%s\n' "$TPL_MARIADB_SERVERS" | while read -r name series image container port tls; do
        [ -n "$name" ] || continue
        case "$filter" in
            tls)   [ "$tls" = yes ] || continue ;;
            notls) [ "$tls" = no ]  || continue ;;
        esac
        "$callback" "$name" "$series" "$image" "$container" "$port" "$tls"
    done
}

# Every container name the fixture owns, space separated. down.sh removes
# exactly these and nothing else: the host may be running containers that
# belong to other projects.
tpl_mariadb_containers() {
    printf '%s\n' "$TPL_MARIADB_SERVERS" | awk 'NF {printf "%s ", $4}'
}

# One record, by name. Prints the whole line; field 2 is the series, 3 the
# image, 4 the container, 5 the host port, 6 whether it offers TLS.
tpl_mariadb_record() {
    printf '%s\n' "$TPL_MARIADB_SERVERS" | awk -v n="$1" '$1 == n { print; found = 1 } END { exit !found }'
}

tpl_mariadb_field() { tpl_mariadb_record "$1" | awk -v f="$2" '{ print $f }'; }

# The flags a `docker exec` client needs to reach its own server. Only the
# --skip-ssl server needs one: a client of 11.4 or later refuses a server that
# offers no TLS even over the Unix socket, and answers "SSL is required, but the
# server does not support it".
tpl_mariadb_client_flags() {
    [ "$(tpl_mariadb_field "$1" 6)" = no ] && printf -- '--skip-ssl' || true
}

# Run SQL as root on a named server, over the container's Unix socket. The
# socket sidesteps every TLS question, which is what an observer wants: it is
# there to watch the connections under test, not to add one of its own to the
# transport matrix.
tpl_mariadb_sql() {
    local name="$1"; shift
    local container flags
    container="$(tpl_mariadb_field "$name" 4)"
    [ -n "$container" ] || { printf 'unknown server: %s\n' "$name" >&2; return 2; }
    flags="$(tpl_mariadb_client_flags "$name")"
    docker exec -i "$container" mariadb $flags -uroot -p"$TPL_MARIADB_ROOT_PASSWORD" "$@"
}

# Is a MariaDB answering on a host port? Prints the version its handshake
# carries, and fails when nothing answers.
#
# This is the fixture's one readiness test, and it is deliberately made from
# outside every container: during initialisation the official entrypoint runs a
# temporary server with --skip-networking, which answers over the Unix socket
# and is not the server under test. A readiness check made with `docker exec`
# therefore passes in the middle of the init scripts and hands the caller a
# server that is about to restart. The published port is up only when the real
# server is.
#
# It needs no client installed, which matters for the gate: a contributor may
# have none and must still be able to ask whether the fixture is up.
tpl_mariadb_handshake() {
    local port="$1" first version
    exec 3<>"/dev/tcp/127.0.0.1/$port" || return 1

    # One byte first, with a timeout. A port that accepts a connection and then
    # says nothing is what a half-started container looks like, and it must not
    # block the gate; a MariaDB answers immediately.
    if ! IFS= read -r -n 1 -t 5 first <&3; then
        exec 3<&- 3>&-
        return 1
    fi

    # The rest of the greeting: a four-byte packet header, the protocol version
    # byte, then the server version as a NUL-terminated string. The whole packet
    # is about a hundred bytes on every series, so 79 more never blocks and the
    # version is well inside them. Reading to the first NUL instead does not
    # work: the packet header's own length field contains NUL bytes and the read
    # stops on the second one.
    version="$(head -c 79 <&3 | LC_ALL=C tr -c '[:print:]' '\n' \
        | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    exec 3<&- 3>&-

    [ -n "$version" ] || return 1
    printf '%s\n' "$version"
}
